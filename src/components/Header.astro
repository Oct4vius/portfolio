---
import type { Locale, SiteContent } from '../content';
import { withBase } from '../lib/paths';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const current = content.locale;
const locales: Locale[] = ['en', 'es'];
const localePath: Record<Locale, string> = { en: withBase(''), es: withBase('es/') };
const label = (l: Locale) => (l === current ? l.toUpperCase() : content.nav.switchLabel);
---

<header class="page header">
  <a class="handle mono" href={localePath[current]}>oct4vius</a>

  <nav class="lang" aria-label={content.nav.label}>
    {
      locales.map((l, i) => (
        <>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              /
            </span>
          )}
          {l === current ? (
            <span class="lang-current" aria-current="page">
              {label(l)}
            </span>
          ) : (
            <a class="lang-link" href={localePath[l]} hreflang={l} lang={l} data-lang-switch data-path={localePath[l]}>
              {label(l)}
            </a>
          )}
        </>
      ))
    }
  </nav>
</header>

<script>
  // Keep the reader on the same section when switching language: the target page
  // uses identical section ids, so carry the current hash over.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]')) {
    const sync = () => {
      link.href = (link.dataset.path ?? link.pathname) + location.hash;
    };
    sync();
    window.addEventListener('hashchange', sync);
    link.addEventListener('click', sync);
    link.addEventListener('auxclick', sync);
  }
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    font-size: 0.8125rem;
  }

  .handle,
  .lang-link {
    display: inline-block;
    color: var(--muted);
    /* Bigger hit area without shifting the layout */
    padding: 0.375rem 0.5rem;
    margin: -0.375rem -0.5rem;
    border-radius: 6px;
    transition: transform var(--dur-press) var(--ease-out);
  }

  .handle:active,
  .lang-link:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .handle:hover,
    .lang-link:hover {
      color: var(--fg);
    }
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    letter-spacing: 0.02em;
  }

  .lang-link {
    margin: -0.375rem -0.25rem;
    padding: 0.375rem 0.25rem;
  }

  .lang-current {
    color: var(--fg);
  }

  .sep {
    color: var(--subtle);
  }
</style>
