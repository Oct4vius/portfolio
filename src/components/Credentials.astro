---
import type { SiteContent } from '../content';

interface Props {
  content: SiteContent;
}

const { education, certifications, languages } = Astro.props.content;
---

<div>
  <p class="primary">{education.degree}</p>
  <p class="secondary">
    {education.school}
    <span class="sep" aria-hidden="true">·</span>
    <span class="mono">{education.year}</span>
  </p>
</div>

<ul class="certs">
  {
    certifications.map((cert) => (
      <li>
        <span class="primary">{cert.name}</span>
        <span class="secondary">
          {cert.issuer}
          <span class="sep" aria-hidden="true">·</span>
          <span class="mono">{cert.date}</span>
        </span>
      </li>
    ))
  }
</ul>

<p class="langs">
  {
    languages.map((lang, i) => (
      <>
        {i > 0 && (
          <span class="sep" aria-hidden="true">
            ·
          </span>
        )}
        <span>{lang}</span>
      </>
    ))
  }
</p>

<style>
  .primary {
    color: var(--fg);
  }

  .secondary {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .mono {
    font-size: 0.8125rem;
    color: var(--subtle);
  }

  .sep {
    margin-inline: 0.375rem;
    color: var(--subtle);
  }

  .certs {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.875rem;
  }

  .certs li {
    display: grid;
    gap: 0.125rem;
  }

  .langs {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
